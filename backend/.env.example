IRISA_PORT=8080

IRISA_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/irisa?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
IRISA_MYSQL_USERNAME=irisa
IRISA_MYSQL_PASSWORD=change-me

IRISA_REDIS_HOST=127.0.0.1
IRISA_REDIS_PORT=6379
IRISA_REDIS_PASSWORD=

IRISA_JWT_SECRET=change-me-to-at-least-32-chars!!
IRISA_JWT_TTL_SECONDS=604800
IRISA_AUTH_MOCK_ENABLED=true
IRISA_AUTH_GITHUB_ENABLED=false

IRISA_LLM_PROVIDER=script

IRISA_ES_URIS=http://127.0.0.1:9200
IRISA_ROCKETMQ_ENDPOINTS=127.0.0.1:8081

IRISA_APOLLO_ENABLED=false
IRISA_APOLLO_APP_ID=irisa
IRISA_APOLLO_META=http://127.0.0.1:8070
IRISA_APOLLO_CLUSTER=default
IRISA_APOLLO_NAMESPACES=application
IRISA_APOLLO_CACHE_DIR=./.apollo-cache
